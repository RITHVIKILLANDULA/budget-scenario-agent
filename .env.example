# Optional. Everything works with this file absent and every value empty:
# the rules parser reads the question and nothing leaves the machine.
#
# Copy to .env (gitignored) or export these in your shell. With a key set,
# the question goes to the model first and falls back to the rules parser
# whenever the model's proposal does not survive the schema.

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Any OpenAI-compatible endpoint.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=12

# Set to off to ignore a key that is already in your environment.
BUDGET_LLM=on
