---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	parse(parse)
	validate(validate)
	baseline(baseline)
	simulate(simulate)
	explain(explain)
	reject(reject)
	__end__([<p>__end__</p>]):::last
	__start__ --> parse;
	baseline --> simulate;
	parse -.-> reject;
	parse -.-> validate;
	simulate --> explain;
	validate -.-> baseline;
	validate -.-> reject;
	explain --> __end__;
	reject --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
